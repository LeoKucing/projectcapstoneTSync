{
  "name": "tsync-prototype",
  "version": "1.0.0",
  "description": "Tsync - Collaborative Task Management Application Prototype",
  "type": "module",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "keywords": [
    "task-management",
    "tsync",
    "react",
    "tailwind",
    "nodejs",
    "express",
    "postgresql",
    "kanban"
  ],
  "author": "Tsync Team",
  "license": "MIT"
}
