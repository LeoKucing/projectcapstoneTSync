{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/tasks(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/projects(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/members(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/analytics(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    }
  ]
}
